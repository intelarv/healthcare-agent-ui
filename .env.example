# AWS Configuration (for AG-UI adapter → Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock Model (Strands cross-region inference profile format)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Research Agent - Serper API
SERPER_API_KEY=

# Sub-agent URLs (docker-compose sets these automatically)
POLICY_AGENT_URL=http://policy-agent:8080/invocations
PROVIDER_AGENT_URL=http://provider-agent:8080/invocations
RESEARCH_AGENT_URL=http://research-agent:8080/invocations

# AG-UI adapter URL (CopilotKit Runtime connects here)
AGENT_URL=http://agui-adapter:8000
